# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Session Security (at least 64 hex characters = 256 bits of entropy)
SESSION_SECRET=your-random-64-character-hex-secret-here

# Server & Environment Settings
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# PayPal Payment Gateway Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=production

# AI Chatbot Backend Configuration (Kept strictly on backend/server)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=openai/gpt-4o-mini
